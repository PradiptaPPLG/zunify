{
  "name": "zunify-backend",
  "version": "1.0.0",
  "description": "Zunify music streaming backend — yt-dlp powered",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
